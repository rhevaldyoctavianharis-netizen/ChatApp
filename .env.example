PORT=3000
NODE_ENV=development
POSTGRES_USER=chat
POSTGRES_PASSWORD=ganti-dengan-password-lokal
POSTGRES_DB=chatapp
## DATABASE_SSL_CA dapat diisi CA PEM untuk koneksi database non-lokal.
# DATABASE_SSL_CA=
# DATABASE_SSL_REJECT_UNAUTHORIZED=true bila CA provider tersedia.
DATABASE_URL=postgres://chat:chat@localhost:5432/chatapp
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
CORS_ORIGIN=*
MAX_MEDIA_MB=16
# Opsional: wajib bila dyno web > 1 (Heroku Key-Value Store / Redis)
# REDIS_URL=
## REDIS_TLS_CA dapat diisi CA PEM bila provider Redis memerlukannya.
# REDIS_TLS_CA=
